# Copy this file to .env and fill in real values before running.

# --- Database ---
# Matches docker-compose.yml's postgres service by default.
DATABASE_URL=postgresql+asyncpg://gtm_user:gtm_password@localhost:5432/gtm_analyzer

# --- Crawler limits ---
MAX_PAGES=500
MAX_DEPTH=10
CRAWL_TIMEOUT=30
CONCURRENT_REQUESTS=5
RETRY_ATTEMPTS=2
RESPECT_ROBOTS_TXT=true
ALLOW_EXTERNAL_DOMAINS=false
USER_AGENT=GTM-Analyzer-Bot/1.0 (+https://example.com/bot)

# --- LLM / Embeddings (Phase 2 onward) ---
# Leave OPENAI_API_KEY empty to use the deterministic offline "fake"
# embedding provider (fine for trying out the crawler/chunking/retrieval
# pipeline, NOT fine for a real GTM report — its vectors carry no real
# semantic meaning). Set a real key to use real embeddings.
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
